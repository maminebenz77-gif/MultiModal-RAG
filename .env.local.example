# Copy to .env.local and fill in real values. Never commit .env.local itself.
# Profile: Mac dev/test — external API access allowed, dummy/non-sensitive docs only.

# --- LLM -----------------------------------------------------------------
# provider: "litellm" (any OpenAI-compatible backend) | "internal_server" (bespoke internal API)
LLM_PROVIDER=litellm
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=sk-replace-with-your-openai-key

# --- Embeddings ------------------------------------------------------------
# provider: "sentence_transformers" (local model) | "litellm" (remote embedding API)
# Cheap enough (~$0.02/1M tokens) that cost isn't a real constraint here, and
# strong on technical text from broad pretraining. To use the free local
# fallback instead, switch to:
#   EMBED_PROVIDER=sentence_transformers
#   EMBED_MODEL=BAAI/bge-base-en-v1.5
#   EMBED_BASE_URL=
#   EMBED_API_KEY=
EMBED_PROVIDER=litellm
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-replace-with-your-openai-key

# --- Vision ----------------------------------------------------------------
# provider: "litellm" (any OpenAI-compatible multimodal backend) | "internal_server" (bespoke internal API)
# VISION_BASE_URL can be left blank for OpenAI too (litellm routes gpt-4o*
# models there by default) — set explicitly here for clarity.
VISION_PROVIDER=litellm
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=sk-replace-with-your-openai-key

# --- Stores ------------------------------------------------------------
# Assumes local docker-compose services.
QDRANT_URL=http://localhost:6333
ELASTIC_URL=http://localhost:9200

# --- Runtime -----------------------------------------------------------
DEVICE=auto
ALLOW_EXTERNAL=true
