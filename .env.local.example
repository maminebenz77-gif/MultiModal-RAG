# Copy to .env.local and fill in real values. Never commit .env.local itself.
# Profile: Mac dev/test — external API access allowed, dummy/non-sensitive docs only.

# --- LLM -----------------------------------------------------------------
# provider: "litellm" (any OpenAI-compatible backend) | "internal_server" (bespoke internal API)
LLM_PROVIDER=litellm
LLM_MODEL=gemma4
LLM_BASE_URL=https://litellm.apps.ocp1.morpheus.quantumai.safran
LLM_API_KEY=

# --- Embeddings ------------------------------------------------------------
# provider: "sentence_transformers" (local model) | "litellm" (remote embedding API)
# Cheap enough (~$0.02/1M tokens) that cost isn't a real constraint here, and
# strong on technical text from broad pretraining. To use the free local
# fallback instead, switch to:
# EMBED_PROVIDER=sentence_transformers
# EMBED_MODEL=C:/SafApp/embedding_models/bge-base-en-v1.5
# EMBED_BASE_URL=
# EMBED_API_KEY=
EMBED_PROVIDER=litellm
EMBED_MODEL=openai/harrier-oss-v1-0.6b
EMBED_BASE_URL=https://litellm.apps.ocp1.morpheus.quantumai.safran/v1
EMBED_API_KEY=

# --- Vision ----------------------------------------------------------------
# provider: "litellm" (any OpenAI-compatible multimodal backend) | "internal_server" (bespoke internal API)
# VISION_BASE_URL can be left blank for OpenAI too (litellm routes gpt-4o*
# models there by default) — set explicitly here for clarity.
VISION_PROVIDER=litellm
VISION_MODEL=gemma4
VISION_BASE_URL=https://litellm.apps.ocp1.morpheus.quantumai.safran
VISION_API_KEY=

# --- Reranker ----------------------------------------------------------
# provider: "cross_encoder" (local, sentence-transformers) — only option implemented so far.
# Applied to an already-retrieved candidate set, not used for retrieval itself.
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BASE_URL=
RERANKER_API_KEY=

# --- Langfuse tracing ----------------------------------------------------
# Entirely optional -- unset (the default) means every trace/generation/
# event call becomes a no-op. LANGFUSE_HOST is meant to point at a
# self-hosted Langfuse instance -- the public Langfuse Cloud
# (cloud.langfuse.com and its regional variants) is refused by default,
# even with allow_external=true, since real query/answer/retrieved
# content shouldn't go to a third party without a deliberate decision to
# do so. Leaving LANGFUSE_HOST blank also disables tracing, on purpose --
# it never silently defaults to the public cloud the way the SDK itself
# would.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Set true only on a profile/machine where you've made a conscious call
# that the public cloud is fine for this data (e.g. a personal dev
# machine, no confidential documents) -- required IN ADDITION to
# LANGFUSE_HOST pointing at the cloud, for tracing to actually use it.
LANGFUSE_ALLOW_CLOUD_HOST=false

# --- Stores ------------------------------------------------------------
# Assumes local docker-compose services.
QDRANT_URL=http://localhost:6333
ELASTIC_URL=http://localhost:9200

# --- Runtime -----------------------------------------------------------
DEVICE=auto
ALLOW_EXTERNAL=true

# --- System certificates -----------------------------------------------
TRUST_SYSTEM_CERTS=true

# --- Identity / access control -------------------------------------------
# "disabled" (default): every caller gets full access, no token needed --
# unchanged from before this setting existed. "oidc" requires a valid
# bearer token on every request; the three OIDC_* values below are then
# required too.
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# --- Frontend ------------------------------------------------------------
# Where the Streamlit app finds the API. See frontend/config.py.
API_BASE_URL=http://127.0.0.1:8000
