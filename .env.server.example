# Copy to .env.server and fill in real values. Never commit .env.server itself.
# Profile: air-gapped company GPU server — no internet, real sensitive docs.
# ALLOW_EXTERNAL=false makes external calls structurally impossible (see
# multimodal_rag.providers.factory) — every base_url below must resolve to a
# loopback or private/internal address, or provider construction will raise.

# --- LLM -----------------------------------------------------------------
# provider: "litellm" if the internal gateway speaks the OpenAI-compatible
# schema, "internal_server" if it has its own bespoke request/response shape.
LLM_PROVIDER=litellm
LLM_MODEL=internal-llama-70b
LLM_BASE_URL=http://10.0.0.5:8080/v1
LLM_API_KEY=replace-with-internal-gateway-key

# --- Embeddings ------------------------------------------------------------
# Runs locally on the GPU box — no network call, no key needed. bge-base
# gives meaningfully better technical-retrieval quality than MiniLM while
# staying fully local; must be pre-cached on this box before first use
# (see multimodal_rag.env_check) since there's no internet to fetch it here.
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_BASE_URL=
EMBED_API_KEY=

# --- Vision ----------------------------------------------------------------
# Optional — many internal gateways don't deploy a vision-capable model at
# all. Leave all four blank if so; ingestion degrades to placeholder
# descriptions gracefully rather than failing. If one *is* deployed and
# OpenAI-compatible, point at it like the LLM section above:
# VISION_PROVIDER=litellm
# VISION_MODEL=internal-vision-model
# VISION_BASE_URL=http://10.0.0.5:8080/v1
# VISION_API_KEY=replace-with-internal-gateway-key
VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# --- Reranker ----------------------------------------------------------
# Runs locally on the GPU box, same reasoning as embeddings above — no
# network call, must be pre-cached before first use on this box.
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BASE_URL=
RERANKER_API_KEY=

# --- Stores ------------------------------------------------------------
# Internal services on the company network — must be private/internal addresses.
QDRANT_URL=http://10.0.0.6:6333
ELASTIC_URL=http://10.0.0.7:9200

# --- Runtime -----------------------------------------------------------
DEVICE=auto
ALLOW_EXTERNAL=false
